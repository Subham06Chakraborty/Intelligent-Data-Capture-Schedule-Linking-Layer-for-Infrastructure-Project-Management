# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to GitHub.

# Path to your Firebase/Google Cloud service account JSON key file.
# This file must NEVER be committed to GitHub.
GOOGLE_APPLICATION_CREDENTIALS="C:\Users\Subham\Documents\GitHub\Intelligent-Data-Capture-Schedule-Linking-Layer-for-Infrastructure-Project-Management\linked-project-management-firebase-adminsdk-fbsvc-92f5c571a6.json"

