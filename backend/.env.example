# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to GitHub.

# Path to your Firebase/Google Cloud service account JSON key file.
# This file must NEVER be committed to GitHub.
GOOGLE_APPLICATION_CREDENTIALS=./sample-data/service-account.json

# Google Cloud project ID (used by Firestore client)
GOOGLE_CLOUD_PROJECT=your-firebase-project-id

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Environment mode: development | production
ENV=development
