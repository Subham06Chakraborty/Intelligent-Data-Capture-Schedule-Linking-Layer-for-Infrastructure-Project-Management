# ─────────────────────────────────────────────────────────────────────────────
# Linked Project Management — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase / Firestore ──────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
GOOGLE_CLOUD_PROJECT=linked-project-management

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Environment ───────────────────────────────────────────────────────────────
ENV=development

# ── Local DB (set to true to bypass Firebase for offline testing) ─────────────
USE_LOCAL_DB=false

# ── Groq AI (required for LLM extraction and audio transcription) ─────────────
GROQ_API_KEY=

# ── Databricks (for ML model training integration) ────────────────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=
